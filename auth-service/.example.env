# Copy to .env to run/test locally:  cp .example.env .env
# .env is git-ignored; .example.env is committed. Do NOT put real secrets here.

# Postgres DSN — REQUIRED. No in-memory fallback. Matches docker-compose.yml.
# Apply the schema before first run:
#   docker compose up -d          # schema applied automatically on first init
#   # OR manually:  psql -f auth-service/migrations/0001_init_limen.up.sql
DATABASE_URL=postgres://auth:auth@localhost:5432/authdb?sslmode=disable

# Signing secret — MUST be exactly 32 bytes. THIS IS A PLACEHOLDER (publicly
# known, zero security). Generate your own:  openssl rand -hex 16
LIMEN_SECRET=0123456789abcdef0123456789abcdef

# If LIMEN_SECRET is left unset, startup fails closed. Set this to "true" to
# permit the built-in insecure dev secret for LOCAL development only. Never set
# it in any shared/staging/production environment.
# AUTH_ALLOW_DEV_SECRET=true

# Base URL used for cookies/links.
AUTH_BASE_URL=http://localhost:8080
